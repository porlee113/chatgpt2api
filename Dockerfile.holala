# Minimal overlay on the VPS-local 1.8.0 image (same digest as previously running stock).
ARG BASE_IMAGE=chatgpt2api:1.8.0-stock
FROM ${BASE_IMAGE}
COPY VERSION /app/VERSION
COPY services/account_service.py /app/services/account_service.py
COPY services/config.py /app/services/config.py
COPY services/protocol/conversation.py /app/services/protocol/conversation.py
